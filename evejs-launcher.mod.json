{
  "schemaVersion": 3,
  "id": "autoLogo",
  "displayName": "Auto Logo",
  "version": "1.1.4",
  "description": "Publishes alliance and corporation logos from one folder: drop <id>.png, .jpg or .jpeg (max 1280x1280) into mods/autoLogo/logo. Alliance and corporation ids never collide, so one folder serves both; there are no commands: add, overwrite or delete the image file.",
  "kind": "loader",
  "supportedBackends": [
    "native",
    "docker"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "261018.1",
      "261028.1",
      "261108.1",
      "261115.2"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "settings",
        "base": "evejs",
        "path": "config/autoLogo.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "logoPath",
        "label": "Logo folder (relative to the EveJS root)",
        "description": "Drop <id>.png, .jpg or .jpeg here. The default lives outside mods/ so a launcher update keeps the images.",
        "type": "string",
        "default": "_local/autoLogo/logo",
        "restart": "game_server",
        "file": "settings",
        "key": [
          "logoPath"
        ],
        "maxLength": 240
      }
    ]
  },
  "updates": {
    "provider": "github",
    "repository": "HalCyonNJ/EveJS-AutoLogo",
    "asset": "autoLogo-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v",
    "preserveFiles": []
  }
}
